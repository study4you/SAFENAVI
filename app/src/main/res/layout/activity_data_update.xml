<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101820">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="주행 데이터 업데이트"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="단속정보를 선택 지역별로 갱신하고, 오프라인 지도·도로 데이터도 함께 다운로드합니다."
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/selectDefaultButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="기본지역" />

            <Button
                android:id="@+id/selectAllButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="전국 선택" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="저장된 지역 데이터 없음"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <CheckBox android:id="@+id/cbSeoul" android:layout_width="match_parent" android:layout_height="48dp" android:text="서울특별시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbBusan" android:layout_width="match_parent" android:layout_height="48dp" android:text="부산광역시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbDaegu" android:layout_width="match_parent" android:layout_height="48dp" android:text="대구광역시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbIncheon" android:layout_width="match_parent" android:layout_height="48dp" android:text="인천광역시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbGwangju" android:layout_width="match_parent" android:layout_height="48dp" android:text="광주광역시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbDaejeon" android:layout_width="match_parent" android:layout_height="48dp" android:text="대전광역시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbUlsan" android:layout_width="match_parent" android:layout_height="48dp" android:text="울산광역시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbSejong" android:layout_width="match_parent" android:layout_height="48dp" android:text="세종특별자치시" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbGyeonggi" android:layout_width="match_parent" android:layout_height="48dp" android:text="경기도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbGangwon" android:layout_width="match_parent" android:layout_height="48dp" android:text="강원특별자치도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbChungbuk" android:layout_width="match_parent" android:layout_height="48dp" android:text="충청북도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbChungnam" android:layout_width="match_parent" android:layout_height="48dp" android:text="충청남도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbJeonbuk" android:layout_width="match_parent" android:layout_height="48dp" android:text="전북특별자치도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbJeonnam" android:layout_width="match_parent" android:layout_height="48dp" android:text="전라남도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbGyeongbuk" android:layout_width="match_parent" android:layout_height="48dp" android:text="경상북도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbGyeongnam" android:layout_width="match_parent" android:layout_height="48dp" android:text="경상남도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />
        <CheckBox android:id="@+id/cbJeju" android:layout_width="match_parent" android:layout_height="48dp" android:text="제주특별자치도" android:textColor="#FFFFFF" android:buttonTint="#4DA3FF" />

        <Button
            android:id="@+id/updateSelectedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:text="단속 + 지도 + 도로 업데이트"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="업데이트 대기"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
